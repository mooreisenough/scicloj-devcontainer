#!/usr/bin/env bash
set -euo pipefail

## Hardened entrypoint for Dyalog runtime
printf "\nStarting scicloj Dyalog entrypoint\n" >&2

# ASCII banner (kept for familiarity)
cat <<'BANNER' >&2
 _______     __      _      ____   _____ 
|  __ \\ \   / //\   | |    / __ \\ / ____|
|_|  | \\ \_/ //  \  | |   | |  | | |     
         | |\   // /\ \ | |   | |  | | |   _ 
 ____| | | |/ /  \ \| |___| |__| | |__| |
|_____/  |_/ _/    \_\______\\____/ \_____|

https://www.dyalog.com
BANNER

# Dyalog installation root (template replaced by Dockerfile)
DYALOG="/opt/mdyalog/{{DYALOG_RELEASE}}/64/unicode"

if [ ! -d "$DYALOG" ]; then
    printf "Dyalog directory not found: %s\n" "$DYALOG" >&2
    exit 1
fi

export DYALOG
export LD_LIBRARY_PATH="${DYALOG}:${LD_LIBRARY_PATH:-}"
export WSPATH="${WSPATH:-}"        # will append WS entries below if needed
export TERM="${TERM:-dumb}"
export APL_TEXTINAPLCORE="${APL_TEXTINAPLCORE:-1}"
export TRACE_ON_ERROR="${TRACE_ON_ERROR:-0}"
export SESSION_FILE="${SESSION_FILE:-$DYALOG/default.dse}"

# Use nullglob so globs that match nothing expand to empty list
shopt -s nullglob

# Only try to auto-detect files if user has not provided LOAD/CONFIGFILE/DYAPP
if [ -z "${LOAD:-}" ] && [ -z "${CONFIGFILE:-}" ] && [ -z "${DYAPP:-}" ]; then
    dcfg=(/app/*.dcfg)
    aplf=(/app/*.aplf)
    apln=(/app/*.apln)
    aplc=(/app/*.aplc)
    dyapp=(/app/*.dyapp)
    dws=(/app/*.dws)

    if [ ${#dcfg[@]} -eq 1 ]; then
        CONFIGFILE="${dcfg[0]}"
        printf "found config file; launching with CONFIGFILE=%s\n" "$CONFIGFILE" >&2
        export CONFIGFILE
    elif [ ${#aplf[@]} -eq 1 ]; then
        LOAD="${aplf[0]}"
        printf "found .aplf; launching with LOAD=%s\n" "$LOAD" >&2
        export LOAD
    elif [ ${#apln[@]} -eq 1 ]; then
        LOAD="${apln[0]}"
        printf "found .apln; launching with LOAD=%s\n" "$LOAD" >&2
        export LOAD
    elif [ ${#aplc[@]} -eq 1 ]; then
        LOAD="${aplc[0]}"
        printf "found .aplc; launching with LOAD=%s\n" "$LOAD" >&2
        export LOAD
    elif [ ${#dyapp[@]} -eq 1 ]; then
        DYAPP="${dyapp[0]}"
        printf "found .dyapp; launching with DYAPP=%s\n" "$DYAPP" >&2
        export DYAPP
    elif [ ${#dws[@]} -eq 1 ]; then
        WS="${dws[0]}"
        printf "found .dws; launching with WS=%s\n" "$WS" >&2
        export WS
    elif [ ${#dyapp[@]} -gt 1 ]; then
        printf "found multiple .dyapp files; starting Dyalog with CLEAR WS\n" >&2
    elif [ ${#dws[@]} -gt 1 ]; then
        printf "found multiple .dws files; starting Dyalog with CLEAR WS\n" >&2
    else
        printf "nothing to load in /app; starting with CLEAR WS\n" >&2
    fi
else
    printf "LOAD, CONFIGFILE or DYAPP provided externally; not auto-detecting defaults\n" >&2
fi

# Append Dyalog workspaces to WSPATH
WSPATH="${WSPATH:+$WSPATH:}$DYALOG/ws"
export WSPATH

# Execute Dyalog as PID 1 (replace shell). Quote args safely.
if [ -n "${RIDE_INIT:-}" ]; then
    exec "$DYALOG/dyalog" +s -q ${WS:+"$WS"} "$@"
else
    exec "$DYALOG/dyalog" -s ${WS:+"$WS"} "$@"
fi

